# Review paths, hostname, TLS policy, rate limits and network restrictions before deployment.
# Place limit_req_zone in the nginx http context.
limit_req_zone $binary_remote_addr zone=ccf:10m rate=5r/s;
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/ccf/tls/fullchain.pem;
    ssl_certificate_key /etc/ccf/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    return 444;
}
server {
    listen 443 ssl;
    server_name ccf.example.invalid;
    ssl_certificate /etc/ccf/tls/fullchain.pem;
    ssl_certificate_key /etc/ccf/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Exact authority check before forwarding; reject absent, alternate or port-suffixed Host.
    if ($http_host != "ccf.example.invalid") { return 444; }
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    access_log off;
    location /v1/ {
        limit_req zone=ccf burst=10 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 35s;
    }
    location / { return 404; }
}
