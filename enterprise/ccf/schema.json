{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SH CCF normalized preparation snapshot v0.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "classification",
    "source_manifest",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "classification": {
      "const": "PUBLIC_SYNTHETIC_PREPARATION"
    },
    "source_manifest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "version",
          "effective_from",
          "effective_to",
          "recorded_on",
          "status",
          "origin",
          "source_refs",
          "unresolved_fields",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "domain",
              "boundary",
              "enterprise_objective",
              "objective",
              "risk",
              "role",
              "control",
              "applicability",
              "implementation",
              "policy_gap",
              "decision",
              "component",
              "provider",
              "dependency",
              "service"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "recorded_on": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "draft",
              "approved",
              "effective",
              "suspended",
              "retired"
            ]
          },
          "origin": {
            "const": "DERIVED_PREPARATION"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "unresolved_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "domain"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "title",
                    "scope"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "scope": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "boundary"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "title",
                    "type",
                    "parent_id",
                    "legal_entity_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
