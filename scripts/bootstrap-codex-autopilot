#!/usr/bin/env bash
set -Eeuo pipefail

BRANCH="finance/enterprise-financial-platform-v0.1"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT" ]] || { echo "Run this from a normal terminal inside SABLEHARBOR." >&2; exit 2; }
cd "$ROOT"

for tool in git gh codex uv python3 timeout flock; do
  command -v "$tool" >/dev/null 2>&1 || { echo "Missing required command: $tool" >&2; exit 2; }
done
gh auth status >/dev/null 2>&1 || { echo "Run: gh auth login" >&2; exit 2; }
gh auth setup-git >/dev/null 2>&1 || true
codex exec --help 2>&1 | grep -q -- '--approve-for-me' || {
  echo "Update Codex CLI; codex exec --approve-for-me is required." >&2
  exit 2
}
[[ -z "$(git status --porcelain)" ]] || {
  echo "The worktree is not clean. Commit or stash unrelated work, then rerun." >&2
  git status --short
  exit 2
}

git fetch origin --prune
if [[ "$(git branch --show-current)" != "$BRANCH" ]]; then
  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git switch "$BRANCH"
  else
    git switch --track -c "$BRANCH" "origin/$BRANCH"
  fi
fi
git pull --ff-only origin "$BRANCH"

KEY="$(printf '%s' "$ROOT" | sha256sum | cut -c1-12)"
HOME_DIR="$HOME/.local/share/sable-harbor-autopilot/$KEY"
BIN_DIR="$HOME/.local/bin"
LAUNCHER="$BIN_DIR/sable-harbor-autopilot"
mkdir -p "$HOME_DIR" "$BIN_DIR"

cat > "$HOME_DIR/program.md" <<'PROGRAM'
# SABLE HARBOR AUTOPILOT PROGRAM

You are operating the SABLE HARBOR repository as one agent in an autonomous builder/test/reviewer
loop. Read `AGENTS.md`, the current repository, PRs #9, #10, and #13, all PR comments and checks,
`docs/handoffs/SABLE_HARBOR_CODEX_EXECUTION_HANDOFF_2026-09-01.md`, and the finance acceptance,
state, architecture, and limitation documents. Do not trust prior completion summaries.

## Binding rules

- Current LOCKED v0.2 canon controls. PROVISIONAL and OPEN matters remain labeled and reversible.
- The repository is intentionally public. Never publish credentials, private personal information,
  hidden benchmark truth, or proprietary NAILEX implementation.
- Alembic is the schema authority. PostgreSQL 16 and SQLite claims require migration-backed tests.
- Preserve balanced double-entry accounting, source-to-ledger lineage, consolidation, eliminations,
  run/scenario isolation, reproducibility, and public-safety boundaries.
- Add semantic tests that fail for the defect they claim to prevent. Never weaken tests or hardcode
  PASS to obtain acceptance.
- Do not commit, push, merge, force-push, delete branches, or change GitHub settings. The outer
  controller owns commits and pushes. Human review owns merges and destructive cleanup.
- Do not modify `scripts/bootstrap-codex-autopilot`.
- Work on the highest-priority incomplete item. Do not stop after planning. Implement, test,
  reconcile, and document as much as can be completed correctly in the current pass.

## Finance phase — branch finance/enterprise-financial-platform-v0.1, PR #9

Finish the financial data platform in dependency order:

1. Close generation identity and run integrity: portable repository-relative digests, complete
   generation-input manifest, content-addressed build/actual-dataset/run identity, immutable legal
   lifecycle transitions, explicit profile contracts, two-seed namespacing, actual-through cutoff
   partitioning, non-null database-enforced same-run relationships, compatible run-context checks,
   scoped accounting/lineage/close APIs, semantic multi-run comparisons, and full SQLite/PostgreSQL
   profile/coexistence/violation matrices.
2. Replace the raw public database snapshot with a new empty allowlisted SQLite database. Scan the
   generated CSV, SQLite, XLSX/XML, manifests, checksums, and archives themselves. Derive release
   metadata and validation status from real state, make releases reproducible, and publish CI
   artifacts only after safety gates pass.
3. Replace workbook title heuristics with an explicit semantic sheet registry. Build six
   database-controlled workbooks whose sheets, formulas, checks, tolerances, units, and selected
   values are tested directly against run-scoped database results.
4. Replace global multipliers with versioned business-line drivers for Foundry/Foundry Field,
   Atlas/Willow, Red Wash, ARU/BS&T, Cradle, Advisory, and capital structure, including attribution
   bridges for revenue, EBITDA, cash, debt, and valuation.
5. Build causal monthly 2023-2026 contract-to-cash, procure-to-pay, payroll, fixed-asset, debt,
   mining, logistics, recovery, research, engagement, inventory, and intercompany subledgers.
6. Produce and reconcile monthly entity and consolidated income statements, balance sheets, cash
   flows, changes in equity, working capital, debt, fixed assets, inventory, and intercompany
   rollforwards for every applicable period and scenario. Expand 2016-2022 or label it consistently
   as calibration only.

The finance phase is complete only when all P0/P1 findings are closed, all SQLite and PostgreSQL
acceptance matrices pass, six semantic workbooks and validated release artifacts are downloadable
from CI, all statements reconcile, PR #9 documentation matches the evidence, and PR #9 remains
unmerged for human review. End the builder response with `PHASE_COMPLETE: finance` only when every
finance criterion is genuinely proven.

## Integration phase — branch integration/enterprise-audit-and-dossiers-v0.1, PR #10

1. Reconcile the latest finance branch into PR #10 and compare PR #10 with PR #13 file by file.
   Preserve unique correct material and document stale, duplicate, historical, or rejected content.
2. Build one coherent company-first information architecture across the root README, company
   dossier, current business-line registry, Wiki source, lore, logos, letterheads, current org
   charts, database/query catalogs, financials, inventories/assets/WIP, lineage, auditability, and
   governance. Classify Foundry, Red Wash, BS&T, Emberline, Evalon, and Blackridge correctly rather
   than treating every identity as a current business line.
3. Use one enterprise database/ledger as source of truth and deterministic read-only unit slices.
   Materialize ARU/BS&T first with filtered SQLite, CSVs, statements, workbook, freight/waybill/
   custody/customer/route/rolling-stock/terminal/parts/fuel/tools/maintenance/workforce/vendor/
   asset/debt/intercompany evidence, lineage, validations, safety report, manifest, and checksums.
   Reconcile ARU to Red Wash and consolidation.
4. Generalize unit-appropriate packages for Foundry Field, Willow, Atlas Meridian, Pale Sun/Red
   Wash, Cradle, and Advisory. Do not fabricate physical inventory for software, research, or
   professional-services units. Every package must reconcile to enterprise consolidation.
5. Finish repository hygiene, link and structure validation, Wiki publication readiness, duplicate
   and historical classification, and branch/PR disposition records without deleting branches.

The integration phase is complete only when the enterprise and unit navigation is coherent, every
current business line has a validated audit package, all unit packages reconcile, all local and CI
checks pass, a fresh reviewer finds no P0/P1 issue, and PR #10 remains unmerged and ready for human
merge sequencing. End the builder response with `PHASE_COMPLETE: integration` only then.
PROGRAM

cat > "$HOME_DIR/runner.sh" <<'RUNNER'
#!/usr/bin/env bash
set -Eeuo pipefail
REPO="$1"; ACTION="${2:-status}"; BASE="$(cd "$(dirname "$0")" && pwd)"
R="$BASE/runtime"; mkdir -p "$R"
PHASE="$R/phase"; PID="$R/pid"; LOG="$R/log"; LOCK="$R/lock"; FEEDBACK="$R/feedback"
BUILDER="$R/builder"; REVIEW="$R/review"; TESTS="$R/tests"; CI="$R/ci"; PROGRAM="$BASE/program.md"
FIN="finance/enterprise-financial-platform-v0.1"; INT="integration/enterprise-audit-and-dossiers-v0.1"
MAX="${MAX_REVISIONS:-12}"; CODEX_TIMEOUT="${CODEX_TIMEOUT:-3h}"
touch "$LOG"
log(){ printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$LOG"; }
phase(){ [[ -f "$PHASE" ]] && cat "$PHASE" || printf finance; }
branch(){ [[ "$1" == finance ]] && printf '%s' "$FIN" || printf '%s' "$INT"; }
pr(){ [[ "$1" == finance ]] && printf 9 || printf 10; }
changes(){ [[ -n "$(git -C "$REPO" status --porcelain)" ]]; }
prepare(){
  local p="$1" b; b="$(branch "$p")"; git -C "$REPO" fetch origin --prune
  if [[ "$(git -C "$REPO" branch --show-current)" != "$b" ]]; then
    changes && { log "Blocked: dirty worktree before branch switch"; printf 'blocked:%s' "$p" > "$PHASE"; exit 1; }
    git -C "$REPO" show-ref --verify --quiet "refs/heads/$b" && git -C "$REPO" switch "$b" || git -C "$REPO" switch --track -c "$b" "origin/$b"
  fi
  changes || git -C "$REPO" pull --ff-only origin "$b"
  if [[ "$p" == integration ]]; then
    git -C "$REPO" fetch origin "+refs/pull/13/head:refs/remotes/codex/pr-13" || true
    git -C "$REPO" merge-base --is-ancestor "origin/$FIN" HEAD || git -C "$REPO" merge --no-ff --no-commit "origin/$FIN" || true
  fi
}
run_tests(){
  : > "$TESTS"; local cmd
  for cmd in "git diff --check" "uv run ruff check ." "uv run mypy src" "uv run pytest"; do
    printf '\n$ %s\n' "$cmd" | tee -a "$TESTS"
    timeout 1h bash -lc "cd '$REPO' && $cmd" 2>&1 | tee -a "$TESTS" || return 1
  done
  for file in scripts/check_public_safety.py scripts/validate_organization_maps.py scripts/validate_enterprise_portal.py scripts/validate_brand_system.py scripts/validate_enterprise_structure.py; do
    [[ -f "$REPO/$file" ]] || continue
    timeout 30m bash -lc "cd '$REPO' && python '$file'" 2>&1 | tee -a "$TESTS" || return 1
  done
}
build_prompt(){ local p="$1"; cat "$PROGRAM"; cat <<EOF

CURRENT PASS: phase=$p branch=$(branch "$p") PR=#$(pr "$p") head=$(git -C "$REPO" rev-parse HEAD)
Implement the highest-priority incomplete tranche now. Do not merely plan. Do not commit or push.
Status:\n$(git -C "$REPO" status --short --branch)
Diff:\n$(git -C "$REPO" diff HEAD --stat || true)
Prior feedback:\n$(cat "$FEEDBACK" 2>/dev/null || echo None)
EOF
}
review_prompt(){ local p="$1"; cat "$PROGRAM"; cat <<EOF

INDEPENDENT READ-ONLY REVIEW: phase=$p head=$(git -C "$REPO" rev-parse HEAD)
Inspect the actual diff and full relevant implementation. Do not edit. Do not trust the builder or
passing test count. First line must be exactly VERDICT: PASS, VERDICT: REVISE, or VERDICT: BLOCKED.
PASS requires no P0/P1 defect in this checkpoint. Approve a PHASE_COMPLETE claim only if every phase
criterion is proven.
Builder:\n$(cat "$BUILDER" 2>/dev/null)
Tests:\n$(tail -n 500 "$TESTS" 2>/dev/null)
EOF
}
wait_ci(){ local n="$1"; : > "$CI"; sleep 8; gh pr checks "$n" --watch --interval 20 2>&1 | tee "$CI"; }
loop(){
  exec 9>"$LOCK"; flock -n 9 || { log "Already running"; exit 0; }; echo $$ > "$PID"; trap 'rm -f "$PID"' EXIT
  local revisions=0 p b n verdict marker sha tests_ok
  while true; do
    p="$(phase)"; [[ "$p" == complete ]] && exit 0; [[ "$p" == blocked:* ]] && exit 1
    b="$(branch "$p")"; n="$(pr "$p")"; prepare "$p"
    log "Builder phase=$p head=$(git -C "$REPO" rev-parse --short HEAD)"
    build_prompt "$p" | timeout "$CODEX_TIMEOUT" codex exec --approve-for-me --ephemeral -C "$REPO" -o "$BUILDER" - >>"$LOG" 2>&1 || { log "Builder transport failure; retrying"; sleep 300; continue; }
    if git -C "$REPO" status --porcelain | grep -q 'scripts/bootstrap-codex-autopilot'; then git -C "$REPO" restore --source=HEAD --staged --worktree scripts/bootstrap-codex-autopilot; echo "Do not modify the bootstrap." > "$FEEDBACK"; continue; fi
    tests_ok=0; run_tests && tests_ok=1
    review_prompt "$p" | timeout "$CODEX_TIMEOUT" codex exec --sandbox read-only --ephemeral -C "$REPO" -o "$REVIEW" - >>"$LOG" 2>&1 || { log "Reviewer transport failure; retrying"; sleep 300; continue; }
    verdict="$(head -n1 "$REVIEW" | tr -d '\r')"
    [[ "$verdict" == 'VERDICT: BLOCKED' ]] && { printf 'blocked:%s' "$p" > "$PHASE"; gh pr comment "$n" --body "Autopilot blocked in **$p**; no merge was attempted." || true; exit 1; }
    if (( tests_ok == 0 )) || [[ "$verdict" != 'VERDICT: PASS' ]]; then
      { echo '# Automated correction feedback'; tail -n500 "$TESTS"; echo; cat "$REVIEW"; } > "$FEEDBACK"
      ((revisions+=1)); log "Revision $revisions/$MAX"; (( revisions < MAX )) || { printf 'blocked:%s' "$p" > "$PHASE"; exit 1; }; continue
    fi
    marker="$(grep -E '^PHASE_COMPLETE: (finance|integration)$' "$BUILDER" | tail -n1 | cut -d' ' -f2 || true)"
    if ! changes; then
      [[ "$marker" == "$p" ]] && { [[ "$p" == finance ]] && echo integration > "$PHASE" || echo complete > "$PHASE"; revisions=0; continue; }
      echo "Review passed but no change was produced; continue the next incomplete tranche." > "$FEEDBACK"; continue
    fi
    git -C "$REPO" add -A; git -C "$REPO" commit -m "codex($p): autonomous accepted checkpoint"; sha="$(git -C "$REPO" rev-parse HEAD)"; git -C "$REPO" push origin "$b"
    wait_ci "$n" || { cp "$CI" "$FEEDBACK"; ((revisions+=1)); continue; }
    revisions=0; rm -f "$FEEDBACK"; gh pr comment "$n" --body "Autopilot accepted checkpoint \`$sha\` after tests, independent review, push, and CI. No merge was performed." || true
    [[ "$marker" == "$p" ]] && { [[ "$p" == finance ]] && echo integration > "$PHASE" || echo complete > "$PHASE"; }
  done
}
case "$ACTION" in
 start) [[ -f "$PID" ]] && kill -0 "$(cat "$PID")" 2>/dev/null && { echo "Already running"; exit 0; }; nohup setsid "$0" "$REPO" run >>"$LOG" 2>&1 < /dev/null & echo $! > "$PID"; sleep 2; "$0" "$REPO" status;;
 run) loop;;
 stop) [[ -f "$PID" ]] && kill "$(cat "$PID")" 2>/dev/null || true; rm -f "$PID"; echo stopped;;
 resume) p="$(phase)"; [[ "$p" == blocked:* ]] && echo "${p#blocked:}" > "$PHASE"; rm -f "$FEEDBACK"; "$0" "$REPO" start;;
 status) echo "phase=$(phase)"; [[ -f "$PID" ]] && kill -0 "$(cat "$PID")" 2>/dev/null && echo "running pid=$(cat "$PID")" || echo stopped; tail -n12 "$LOG";;
 logs) tail -f "$LOG";;
 *) echo "Usage: sable-harbor-autopilot {start|stop|resume|status|logs}" >&2; exit 2;;
esac
RUNNER

cat > "$LAUNCHER" <<EOF
#!/usr/bin/env bash
exec "$HOME_DIR/runner.sh" "$ROOT" "\${1:-status}"
EOF
chmod +x "$HOME_DIR/runner.sh" "$LAUNCHER"

"$LAUNCHER" stop >/dev/null 2>&1 || true
"$LAUNCHER" start

echo
echo "Autopilot installed and running. No further Codex handoffs are required."
echo "Status: $LAUNCHER status"
echo "Logs:   $LAUNCHER logs"
echo "Stop:   $LAUNCHER stop"
